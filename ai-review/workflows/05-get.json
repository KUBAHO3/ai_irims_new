    {
      "id": "63784199-8005-5819-9907-96313b0ab45c",
      "name": "Build response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const row = $input.first().json;\nif (!row || !row.id) return [{ json: { code: 404, body: { message: 'Analysis not found' } } }];\nconst body = row.result || { analysisId: row.id, status: row.status, applicationRef: row.application_ref, productType: row.product_type };\nif (row.status === 'failed') body.error = row.error;\nbody.createdAt = row.created_at;\nbody.finishedAt = row.finished_at;\nreturn [{ json: { code: 200, body } }];\n"
      }
    },
    {
      "id": "25abe15f-1b87-5307-9f03-21513c36aadb",
