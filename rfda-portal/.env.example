# apps/api/.env
DATABASE_URL="postgresql://rfda:change-me@localhost:5440/rfda_portal?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4100
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=200
# Set to "true" only in production behind HTTPS
COOKIE_SECURE=false
# AI review service (n8n, see ../../ai-review/GUIDE.md). Leave AI_N8N_URL empty to hide the feature.
AI_N8N_URL="http://localhost:5678/webhook"
AI_API_KEY=""
AI_CALLBACK_KEY=""
# Must be reachable from the n8n container: host.docker.internal when both run on one Mac
AI_CALLBACK_URL="http://host.docker.internal:4100/ai/callback"
AI_MAX_UPLOAD_MB=60
# How many AI pre-checks an applicant may run per application per day
AI_APPLICANT_DAILY_LIMIT=5
